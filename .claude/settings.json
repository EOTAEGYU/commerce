{
  "permissions": {
    "allow": [
      "Bash(./gradlew build *)",
      "Bash(./gradlew :apps:api:compileTestKotlin)",
      "Bash(./gradlew test *)",
      "Bash(./gradlew bootRun)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git status)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git checkout *)",
      "Bash(git pull *)",
      "Bash(git branch *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr list *)",
      "Bash(npm run build *)",
      "Bash(npm run lint *)",
      "Bash(npm run dev)",
      "Bash(npm run dev *)",
      "Bash(npx tsc *)",
      "Bash(npx jest *)",
      "Bash(cd apps/web && npm run build)",
      "Bash(cd apps/web && npm run dev)",
      "Bash(cd apps/web && npm run lint)",
      "Bash(cd apps/web && npx tsc *)",
      "Bash(cd apps/web && npx jest *)",
      "Bash(git -C * add *)",
      "Bash(git -C * commit *)",
      "Bash(git -C * push *)",
      "Bash(git -C * status)",
      "Bash(git -C * diff *)"
    ]
  },
  "enabledMcpjsonServers": [
    "plan-review"
  ],
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import sys,json; d=json.load(sys.stdin); f=d.get('tool_input',{}).get('file_path',''); print(f)\" | grep -q '\\.kt$' || exit 0; ./gradlew :apps:api:compileKotlin 2>&1 | tail -5 && exit 0 || exit 2",
            "timeout": 60,
            "asyncRewake": true,
            "rewakeSummary": "Kotlin 컴파일 에러 발생",
            "rewakeMessage": "Kotlin 컴파일 실패. 아래 에러를 확인하고 즉시 수정하라:"
          },
          {
            "type": "command",
            "command": "python -c \"import sys,json; d=json.load(sys.stdin); f=d.get('tool_input',{}).get('file_path',''); print(f)\" | grep -qE '\\.(ts|tsx)$' || exit 0; npx --prefix apps/web tsc --noEmit 2>&1 | tail -10 && exit 0 || exit 2",
            "timeout": 60,
            "asyncRewake": true,
            "rewakeSummary": "TypeScript 타입 에러 발생",
            "rewakeMessage": "TypeScript 타입 체크 실패. 아래 에러를 확인하고 즉시 수정하라:"
          }
        ]
      }
    ]
  }
}
